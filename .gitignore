# The local certificate authority. ca-key.pem can mint a certificate any phone
# that trusts ca.pem will believe, for any site — it must never be committed
# and the server refuses to serve this directory at all.
ssl/

# What you have scanned: a list of what you buy, what it costs and when you were
# shopping. It belongs on your machine and not in a repository — the server
# refuses to serve the directory for the same reason.
data/

node_modules/
npm-debug.log*
.DS_Store
*.swp

# Scratch output from the end-to-end harness in tests/.
tests/out/
